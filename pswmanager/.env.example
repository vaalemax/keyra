# .env

# --- Database (used when running the app directly, outside Docker) --
DB_URL=jdbc:postgresql://localhost:5432/keyra
DB_USERNAME=keyra
DB_PASSWORD=changeme

# --- Database (used by docker-compose to initialize the Postgres container) --
POSTGRES_DB=keyra
POSTGRES_USER=keyra
POSTGRES_PASSWORD=changeme

# --- Session cookie -------------------------------------------------
# Set to true when serving the app over HTTPS (required in production).
COOKIE_SECURE=false